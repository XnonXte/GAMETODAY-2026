  m_Script: {fileID: 11500000, guid: bff050e0781311c4f84e15d45c9c5ddd, type: 3}
  m_Name: Stage2 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerName: 
    lineText: "It was not the wounds that weakened the Hero.\LSomething had followed
      him from the castle.\LWith every step, it spread.\LHis strength faded.\LHis
      companions were gone.\LYet he refused to stop.\LHome was still ahead."
